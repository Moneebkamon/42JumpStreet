# names only, put real values in .env
ENVIRONMENT=dev
LOG_LEVEL=info

DATABASE_URL=sqlite:///./fraudshield.db
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# optional
LLM_API_KEY=
SEARCH_API_KEY=
PLACES_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# sandbox
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MAX_BYTES=5000000

# cache and thresholds
CACHE_TTL_SAFE_SECONDS=86400
CACHE_TTL_SUSPICIOUS_SECONDS=900
SCORE_THRESHOLD_WARN=60
SCORE_THRESHOLD_BLOCK=80

MODEL_ARTIFACT_VERSION=

# --- User accounts, message guard and alert email (names only; no values are committed) ---
# Shared secret the WhatsApp / SMS providers send with each webhook (header X-Webhook-Secret or ?secret=). Required.
FRAUDSHIELD_WEBHOOK_SECRET=
# Alert email via SMTP. Leave FRAUDSHIELD_SMTP_HOST empty in dev: emails are written to data/interim/outbox/ instead.
FRAUDSHIELD_SMTP_HOST=
FRAUDSHIELD_SMTP_PORT=587
FRAUDSHIELD_SMTP_USER=
FRAUDSHIELD_SMTP_PASSWORD=
FRAUDSHIELD_SMTP_SSL=0
FRAUDSHIELD_MAIL_FROM=
FRAUDSHIELD_OUTBOX=
# Your own Evolution API instance, used to warn a user on WhatsApp (optional)
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
