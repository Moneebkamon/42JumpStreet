{
  "manifest_version": 3,
  "name": "Manee | منيع",
  "version": "1.9.3",
  "description": "كشف الروابط والمواقع الاحتيالية في بحث Google وخرائط Google داخل الإمارات — يعمل محليًا بالكامل.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.ae/search*",
        "file:///*search-mock.html",
        "http://127.0.0.1/*search-mock.html",
        "http://localhost/*search-mock.html",
        "http://127.0.0.1/*test.html",
        "http://localhost/*test.html"
      ],
      "js": [
        "content-state.js",
        "i18n.js",
        "content-search.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.google.com/maps*",
        "*://www.google.ae/maps*",
        "file:///*maps-mock.html",
        "http://127.0.0.1/*maps-mock.html",
        "http://localhost/*maps-mock.html"
      ],
      "js": [
        "content-state.js",
        "i18n.js",
        "phone-claims.js",
        "content-maps.js"
      ],
      "run_at": "document_idle",
      "css": [
        "content-maps.css"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-page.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-hooks.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manee",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}